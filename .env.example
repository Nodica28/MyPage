# Copy to .env and fill in your own values. Never commit the real .env.

# ─── Core ────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ─── Database — Supabase Postgres ────────────────────────────────────────
# App uses the pooled (Supavisor, transaction-mode, 6543) connection:
DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true
# Migrations / seed use the direct (5432) connection:
DIRECT_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# ─── Supabase Auth (server-side; client talks to /api, so no VITE_ vars) ──
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Public base URL — used for the OAuth callback + magic-link redirect.
# Defaults to http://localhost:5000 in dev; set to your deployed URL in prod.
PUBLIC_URL=http://localhost:5000

# ─── AI / image generation ───────────────────────────────────────────────
OPENAI_API_KEY=
RENDERNET_API_KEY=

# ─── Email (Mailtrap) — lead notifications + team invitations ────────────
MAILTRAP_TOKEN=
MAILTRAP_ACCOUNT_ID=
EMAIL_FROM=hello@example.com
EMAIL_FROM_NAME=Your App
EMAIL_SUPPORT=support@example.com
MAILTRAP_LEAD_NOTIFICATION_TEMPLATE=
MAILTRAP_LEAD_INQUIRY_RESPONSE_TEMPLATE=
MAILTRAP_INVITATION_TEMPLATE=

# NOTE: Stripe, Slack, and Thena were removed from this build.
# Google sign-in is configured in the Supabase dashboard (Auth → Providers),
# not via env vars.
